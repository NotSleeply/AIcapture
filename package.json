{
  "name": "aicapture",
  "version": "1.0.0",
  "description": "Headless Electron screenshot-to-AI runner",
  "packageManager": "pnpm@10.13.1",
  "main": "./src/main/index.js",
  "scripts": {
    "capture": "node scripts/run-electron.js .",
    "dev": "node scripts/run-electron.js .",
    "start": "node scripts/run-electron.js .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.atguigu.video",
    "win": {
      "icon": "./src/static/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "",
  "license": "ISC",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  }
}
