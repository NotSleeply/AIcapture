{
  "name": "aicapture",
  "version": "1.0.0",
  "description": "Electron screenshot-to-AI analysis toolkit",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "package:app": "electron-builder"
  },
  "build": {
    "appId": "com.atguigu.video",
    "win": {
      "icon": "./src/static/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "peerDependencies": {
    "electron": ">=28"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.3"
  }
}