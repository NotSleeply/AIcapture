{
  "name": "capture",
  "version": "1.0.0",
  "packageManager": "pnpm@10.13.1",
  "main": "./src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "start": "nodemon --exec electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.atguigu.video",
    "win": {
      "icon": "./src/static/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "overrides": {
    "@xmldom/xmldom": "^0.8.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "electron",
      "electron-winstaller",
      "tesseract.js"
    ]
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.11"
  },
  "dependencies": {
    "electron-screenshots": "^0.6.1",
    "fe-logs": "^1.0.13",
    "ip-address": "^10.2.0",
    "tesseract.js": "^7.0.0"
  }
}
